    ],
    "canceller_window": 45
  },
  "settings": {
    "_note": [
      "min_margin: the winning side must beat the other by at least this, else",
      "the item is treated as directionless and skipped. Stops an article that",
      "mentions both an outage and a restart being read as either.",
      "",
      "title_multiplier: hits in the headline count for more than hits in the",
      "snippet, because headlines are written to carry the point."
    ],
    "min_margin": 3,
    "title_multiplier": 3.0
  }
