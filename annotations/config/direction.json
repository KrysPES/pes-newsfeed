  "cancellers": {
    "_note": [
      "Words that reverse a bullish term sitting next to them. 'Force majeure",
      "lifted' is bearish, not bullish, and without this it reads as bullish",
      "because 'force majeure' is one of the heaviest bullish terms.",
      "",
      "Matched within `canceller_window` characters either side of the bullish",
      "term. When one fires, the term's weight moves to the bearish side rather",
      "than simply being dropped, because a cancelled disruption is genuinely",
      "bearish news."
    ],
    "terms": [
      "lifted",
      "lifts",
