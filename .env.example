# Copy this file, rename the copy to exactly ".env" and paste your keys in.
# No quotes needed, no spaces around the = sign.
#
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.
# Keys for the deployed version go in GitHub Actions Secrets instead.

AGSI_KEY=paste_your_agsi_key_here

# Leave this line alone until ENTSO-E email you a token, then paste it in.
ENTSOE_TOKEN=
