  "recency": {
    "_readme": [
      "Exponential half-life decay. The previous curve had a 0.40 floor, which",
      "meant a major story parked at score 57 forever and never left the feed.",
      "",
      "At a 9 hour half-life a big story is critical for roughly 4 hours, high",
      "for 9, normal to about 20, and off the default view inside a day.",
      "Raise half_life_hours if things vanish too fast, lower it if the drawer",
      "feels stale."
    ],
    "full_weight_hours": 2.0,
    "half_life_hours": 9.0,
    "floor": 0.1,
    "unknown_timestamp_factor": 0.55
  },
  "supersession": {
    "_readme": [
      "Retires earlier versions of a developing story. See src/supersede.py.",
      "window_days is how far back an update can reach to retire its own",
      "earlier coverage. Too long and unrelated stories about the same asset",
      "get swallowed; too short and Monday's outage outlives Wednesday's fix."
    ],
    "window_days": 5.0,
    "demote": 0.3,
    "hide_superseded": true
  }
}